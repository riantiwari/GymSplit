<%- include('partials/header') %>

<div class="container section">

  <!-- Plan Summary -->
  <div class="plan-summary">
    <h2>🏋️ <%= plan.planName %></h2>
    <div class="summary-tags">
      <span class="tag"><%= plan.goal %></span>
      <span class="tag"><%= plan.experienceLevel %></span>
      <span class="tag"><%= plan.daysPerWeek %> days/week</span>
      <span class="tag"><%= plan.timePerWorkout %></span>
      <% plan.equipment.forEach(e => { %><span class="tag tag-neutral"><%= e %></span><% }) %>
    </div>
  </div>

  <!-- Save Section -->
  <div class="save-section">
    <div>
      <strong>Happy with this plan?</strong>
      <p>Save it to your library so you can access it anytime.</p>
    </div>
    <form action="/plans/save" method="POST">
      <input type="hidden" name="planData" value="<%= JSON.stringify(plan) %>" />
      <button type="submit" class="btn btn-primary">💾 Save This Plan</button>
    </form>
  </div>

  <!-- Workout Days -->
  <h2 class="section-title">Your Workout Split</h2>
  <p class="section-subtitle">
    <% if (plan.goal === 'Build Muscle') { %>Sets: <%= plan.workoutDays[0]?.exercises[0]?.sets %> &bull; Reps: <%= plan.workoutDays[0]?.exercises[0]?.reps %> &bull; Rest: <%= plan.workoutDays[0]?.exercises[0]?.rest %>
    <% } else if (plan.goal === 'Improve Strength') { %>Heavy loads, longer rest. Focus on progressive overload.
    <% } else { %>Follow the sets, reps, and rest times listed for each exercise.
    <% } %>
  </p>

  <div class="day-grid">
    <% plan.workoutDays.forEach((day, idx) => { %>
      <div class="day-card">
        <div class="day-card-header">
          <div class="day-number"><%= idx + 1 %></div>
          <div class="day-card-title"><%= day.dayName %></div>
        </div>
        <div class="day-card-body">
          <% if (day.exercises.length === 0) { %>
            <p style="color: var(--text-muted); font-size: 0.875rem;">No exercises found for this day.</p>
          <% } %>
          <% day.exercises.forEach(ex => { %>
            <div class="exercise-item">
              <div>
                <div class="exercise-name"><%= ex.name %></div>
                <div class="exercise-muscle">🎯 <%= ex.muscle %> &bull; <%= ex.equipment %></div>
                <% if (ex.instructions) { %>
                  <div class="exercise-muscle" style="margin-top:4px;line-height:1.4;"><%= ex.instructions.length > 90 ? ex.instructions.substring(0, 90) + '…' : ex.instructions %></div>
                <% } %>
              </div>
              <div class="exercise-meta">
                <div class="sets-reps"><%= ex.sets %> sets × <%= ex.reps %></div>
                <div class="rest-time">Rest: <%= ex.rest %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Action buttons -->
  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
    <a href="/generate" class="btn btn-secondary">← Generate Another</a>
    <a href="/plans" class="btn btn-secondary">📋 View Saved Plans</a>
  </div>

</div>

<%- include('partials/footer') %>
